# deploy/docker/.env 로 복사한다 (git 제외). docker compose가 compose.yaml 값을 채울 때 쓴다.
# 비밀번호는 URL에 그대로 들어가므로 영문·숫자만 쓴다:  openssl rand -hex 24
# 처음 `docker compose up` 이후에 바꾸면 DB 쪽 비밀번호도 따로 바꿔야 한다 (initdb/10-app-roles.sh 참고).

# DB 소유자 (migration 전용, app 컨테이너에는 전달하지 않는다)
CAREER_DB_OWNER_PASSWORD=
# 앱 계정 career_api (RLS 적용)
CAREER_API_DB_PASSWORD=

# 앱 포트. 기본은 서버 안(127.0.0.1)에서만 열린다. 리버스 프록시 없이 LAN에 열려면 0.0.0.0
# CAREER_BIND=127.0.0.1
# CAREER_HTTP_PORT=8000

# 이미지 빌드 옵션 (쉼표 구분): local-embed (로컬 임베딩, 이미지·메모리 증가), browser (Chromium),
#   pdf-render (스캔 PDF 공고를 쪽 이미지로 바꿔 비전 모델로, ~8MB)
# CAREER_EXTRAS=

# PostgreSQL 메모리. 1GB 서버 기본값. 4GB 이상이면 1GB / 2GB 정도로 올린다.
# CAREER_PG_SHARED_BUFFERS=128MB
# CAREER_PG_EFFECTIVE_CACHE=384MB
