# deploy/docker/app.env 로 복사한다 (git 제외). app 컨테이너의 환경변수가 된다.
# 모델 키는 config/models.toml 의 api_key_env 이름과 맞춘다. 쓰지 않는 키는 비워 두지 말고 지운다.

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=

# `docker compose run --rm app usage` 같은 CLI 명령용 토큰 (bootstrap 출력)
# CAREER_API_TOKEN=

# 내장 worker 끄기 (worker를 따로 띄울 때): 0
# CAREER_EMBEDDED_WORKER=1
# CAREER_WORKER_POLL_SECONDS=1
# CAREER_MAX_UPLOAD_MB=20
# CAREER_LOG_LEVEL=info
# CAREER_ACCESS_LOG=1

# 로컬 임베딩 (이미지를 CAREER_EXTRAS=local-embed 로 빌드했을 때)
# CAREER_EMBED_THREADS=2
# CAREER_EMBED_IDLE_SECONDS=300

# 동적 공고 렌더링 (CAREER_EXTRAS=browser 로 빌드했을 때)
# CAREER_BROWSER_FETCH=1

# 같은 서버의 리버스 프록시가 보내는 X-Forwarded-* 를 믿을 주소 (docker 브리지 게이트웨이 등)
# FORWARDED_ALLOW_IPS=172.16.0.0/12
